@model CarbonFootprintTracker.Models.AdminActivitiesViewModel
@{
    ViewData["Title"] = "Activity Overview";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body">
                    <h2 class="mb-0">📋 Activity Overview</h2>
                    <p class="mb-0">Total Activities: @Model.TotalActivities | Total Emissions: @Model.TotalEmissions kg CO₂</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Activity Type</th>
                            <th>Amount</th>
                            <th>Unit</th>
                            <th>CO₂ Emission</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var activity in Model.Activities)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@activity.UserName</td>
                                <td>@activity.ActivityType</td>
                                <td>@activity.Amount</td>
                                <td>@activity.Unit</td>
                                <td class="fw-bold text-danger">@activity.CarbonEmission kg</td>
                                <td>@activity.Date.ToString("MMM dd, yyyy")</td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>