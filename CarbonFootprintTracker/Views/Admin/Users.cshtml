@model CarbonFootprintTracker.Models.AdminUsersViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-info text-white shadow">
                <div class="card-body">
                    <h2 class="mb-0">👥 User Management</h2>
                    <p class="mb-0">Total Users: @Model.TotalUsers</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Activities</th>
                            <th>Total Emission</th>
                            <th>Points</th>
                            <th>Badges</th>
                            <th>Registered</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@counter</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.ActivityCount</td>
                                <td>@user.TotalEmission kg</td>
                                <td>@user.Points</td>
                                <td>
                                    <span class="badge bg-warning">@user.BadgesEarned</span>
                                </td>
                                <td>@user.RegisteredDate.ToString("MMM dd, yyyy")</td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>