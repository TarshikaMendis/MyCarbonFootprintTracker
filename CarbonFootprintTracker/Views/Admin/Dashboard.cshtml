@model CarbonFootprintTracker.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <!-- Welcome Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow">
                <div class="card-body">
                    <h2 class="mb-0">👋 Welcome, Admin!</h2>
                    <p class="mb-0">Here's an overview of the entire platform</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <!-- Total Users -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow text-center border-0" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="card-body">
                    <h5 class="card-title">Total Users</h5>
                    <h1 class="display-4 fw-bold">@Model.TotalUsers</h1>
                    <p>+@Model.NewUsersThisMonth this month</p>
                </div>
            </div>
        </div>

        <!-- Total Activities -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow text-center border-0" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%); color: white;">
                <div class="card-body">
                    <h5 class="card-title">Total Activities</h5>
                    <h1 class="display-4 fw-bold">@Model.TotalActivities</h1>
                    <p>+@Model.ActivitiesThisMonth this month</p>
                </div>
            </div>
        </div>

        <!-- Total Emissions -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow text-center border-0" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                <div class="card-body">
                    <h5 class="card-title">Total CO₂ Emissions</h5>
                    <h1 class="display-4 fw-bold">@Model.TotalEmissions</h1>
                    <p>@Model.EmissionsThisMonth kg this month</p>
                </div>
            </div>
        </div>

        <!-- Total Badges -->
        <div class="col-lg-3 col-md-6 mb-3">
            <div class="card shadow text-center border-0" style="background: linear-gradient(135deg, #f6d365 0%, #fda085 100%); color: #333;">
                <div class="card-body">
                    <h5 class="card-title">Badges Earned</h5>
                    <h1 class="display-4 fw-bold">@Model.TotalBadgesEarned</h1>
                    <p>Out of @Model.TotalRewards rewards</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Breakdown -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h4 class="mb-0">📊 Emissions by Category (All Users)</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <div class="p-3 border rounded">
                                <h5>🚗 Transport</h5>
                                <h3 class="text-primary">@Model.TransportEmission</h3>
                                <p>kg CO₂</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 border rounded">
                                <h5>⚡ Electricity</h5>
                                <h3 class="text-warning">@Model.ElectricityEmission</h3>
                                <p>kg CO₂</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 border rounded">
                                <h5>🍽️ Food</h5>
                                <h3 class="text-success">@Model.FoodEmission</h3>
                                <p>kg CO₂</p>
                            </div>
                        </div>
                        <div class="col-md-3 text-center">
                            <div class="p-3 border rounded">
                                <h5>🗑️ Waste</h5>
                                <h3 class="text-danger">@Model.WasteEmission</h3>
                                <p>kg CO₂</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activities & Top Users -->
    <div class="row mb-4">
        <!-- Recent Activities -->
        <div class="col-lg-7">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">🔄 Recent Activities</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentActivities.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>User</th>
                                        <th>Type</th>
                                        <th>Amount</th>
                                        <th>Emission</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.RecentActivities)
                                    {
                                        <tr>
                                            <td>@item.UserName</td>
                                            <td>@item.ActivityType</td>
                                            <td>@item.Amount @item.Unit</td>
                                            <td>@item.CarbonEmission kg</td>
                                            <td>@item.Date.ToString("MMM dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No activities yet</p>
                    }
                </div>
            </div>
        </div>

        <!-- Top Users -->
        <div class="col-lg-5">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">🏆 Top Users</h5>
                </div>
                <div class="card-body">
                    @if (Model.TopUsers.Any())
                    {
                        <div class="list-group">
                            @foreach (var user in Model.TopUsers)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@user.UserName</strong>
                                        <br />
                                        <small class="text-muted">@user.ActivityCount activities</small>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">@user.Points pts</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No users yet</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>