@model CarbonFootprintTracker.Models.CarbonActivity

@{
    ViewData["Title"] = "Add Carbon Activity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Add New Carbon Activity</h3>
                </div>
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <!-- Activity Type -->
                        <div class="mb-3">
                            <label asp-for="ActivityType" class="form-label fw-bold"></label>
                            <select asp-for="ActivityType" class="form-select" required>
                                <option value="">-- Select Activity Type --</option>
                                <option value="Transport">🚗 Transport (Car, Bus, Train)</option>
                                <option value="Electricity">⚡ Electricity Usage</option>
                                <option value="Food">🍽️ Food Consumption</option>
                                <option value="Waste">🗑️ Waste Generation</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold"></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" required placeholder="Enter amount..." />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <!-- Unit -->
                        <div class="mb-3">
                            <label asp-for="Unit" class="form-label fw-bold"></label>
                            <select asp-for="Unit" class="form-select" required>
                                <option value="">-- Select Unit --</option>
                                <option value="km">Kilometers (km) - Transport</option>
                                <option value="mile">Miles - Transport</option>
                                <option value="minute">Minutes - Public Transport</option>
                                <option value="kwh">Kilowatt-hours (kWh) - Electricity</option>
                                <option value="unit">Units - Electricity</option>
                                <option value="meal">Meals - Food</option>
                                <option value="kg">Kilograms (kg) - Food/Waste</option>
                                <option value="bag">Bags - Waste</option>
                            </select>
                            <span asp-validation-for="Unit" class="text-danger"></span>
                        </div>

                        <!-- Hidden fields - not shown to user -->
                        <input type="hidden" asp-for="CarbonEmission" />
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Date" />

                        <div class="alert alert-info mt-3">
                            <strong>💡 Note:</strong> Your carbon emission will be calculated automatically based on your activity type, amount, and unit.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-success">Create Activity</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}