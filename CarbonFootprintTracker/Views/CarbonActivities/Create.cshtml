@model CarbonFootprintTracker.Models.CarbonActivity
@using CarbonFootprintTracker.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Add Carbon Activity";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Add New Carbon Activity</h3>
                </div>
                <div class="card-body">
                    <!-- Login Status Check -->
                    @if (!SignInManager.IsSignedIn(User))
                    {
                        <div class="alert alert-danger">
                            <strong>❌ You are NOT logged in!</strong> Please <a href="/Identity/Account/Login">login here</a> first.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <strong>✅ You are logged in as:</strong> @User.Identity?.Name
                        </div>
                    }

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>✅ Success!</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Validation Summary -->
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <form asp-action="Create" method="post">
                        <!-- Activity Type -->
                        <div class="mb-3">
                            <label asp-for="ActivityType" class="form-label fw-bold"></label>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="">-- Select Activity Type --</option>
                                <option value="Transport">🚗 Transport</option>
                                <option value="Electricity">⚡ Electricity</option>
                                <option value="Food">🍽️ Food</option>
                                <option value="Waste">🗑️ Waste</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label fw-bold"></label>
                            <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <!-- Unit -->
                        <div class="mb-3">
                            <label asp-for="Unit" class="form-label fw-bold"></label>
                            <select asp-for="Unit" class="form-select">
                                <option value="">-- Select Unit --</option>
                                <option value="km">Kilometers (km)</option>
                                <option value="mile">Miles</option>
                                <option value="minute">Minutes</option>
                                <option value="kwh">Kilowatt-hours (kWh)</option>
                                <option value="unit">Units</option>
                                <option value="meal">Meals</option>
                                <option value="kg">Kilograms (kg)</option>
                                <option value="bag">Bags</option>
                            </select>
                            <span asp-validation-for="Unit" class="text-danger"></span>
                        </div>

                        <!-- DO NOT include hidden fields for CarbonEmission, UserId, Date -->
                        <!-- They will be set in the controller -->

                        <div class="alert alert-info mt-3">
                            <strong>💡 Note:</strong> Your carbon emission will be calculated automatically.
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-success">Create Activity</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}