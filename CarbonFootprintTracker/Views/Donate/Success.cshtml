@{
    ViewData["Title"] = "Donation Successful";
    var impact = ViewBag.Impact as CarbonFootprintTracker.Services.ImpactStats;
    var transactionId = ViewBag.TransactionId as string;
}

<style>
    .success-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #F0F7F0;
        padding: 2rem;
    }

    .success-card {
        background: #FFFFFF;
        border-radius: 24px;
        padding: 3rem 2.5rem;
        text-align: center;
        max-width: 600px;
        width: 100%;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        border-top: 5px solid #2E7D32;
    }

        .success-card .success-icon {
            font-size: 5rem;
            display: block;
            margin-bottom: 1rem;
            animation: bounce 1s ease;
        }

    @@keyframes bounce {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.3);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }
    }

    .success-card h1 {
        color: #1B5E20;
        font-weight: 700;
        font-size: 2rem;
    }

    .success-card p {
        color: #4A5568;
        font-size: 1.1rem;
    }

    .success-card .transaction-id {
        background: #F0F7F0;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-family: monospace;
        font-size: 1.1rem;
        color: #1B5E20;
        display: inline-block;
        margin: 0.5rem 0;
    }

    .success-card .impact-summary {
        background: #F0F7F0;
        border-radius: 16px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .success-card .impact-item {
        text-align: center;
        flex: 1;
        min-width: 80px;
    }

        .success-card .impact-item .icon {
            font-size: 2rem;
            display: block;
        }

        .success-card .impact-item .value {
            font-weight: 700;
            color: #1B5E20;
            font-size: 1.2rem;
        }

        .success-card .impact-item .label {
            font-size: 0.75rem;
            color: #4A5568;
        }

    .btn-back {
        background: linear-gradient(135deg, #2E7D32 0%, #1B5E20 100%);
        color: #FFFFFF;
        border: none;
        border-radius: 50px;
        padding: 0.8rem 2.5rem;
        font-weight: 600;
        transition: all 0.4s ease;
        text-decoration: none;
        display: inline-block;
        box-shadow: 0 4px 15px rgba(46, 125, 50, 0.3);
    }

        .btn-back:hover {
            background: linear-gradient(135deg, #1B5E20 0%, #0D3B0E 100%);
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(46, 125, 50, 0.4);
            color: #FFFFFF;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .success-card {
            padding: 2rem 1.5rem;
        }

            .success-card h1 {
                font-size: 1.6rem;
            }

            .success-card .impact-summary {
                flex-direction: column;
                align-items: center;
            }
    }
</style>

<div class="success-container">
    <div class="success-card">
        <span class="success-icon">🎉</span>
        <h1>Thank You for Your Donation!</h1>
        <p>Your generosity helps us make the world a greener, cleaner place.</p>

        <div class="transaction-id">
            🧾 Transaction ID: @transactionId
        </div>

        <div class="impact-summary">
            <div class="impact-item">
                <span class="icon">🌳</span>
                <div class="value">@(impact?.TreesPlanted ?? 0)+</div>
                <div class="label">Trees Planted</div>
            </div>
            <div class="impact-item">
                <span class="icon">♻️</span>
                <div class="value">@(impact?.WasteRecycled ?? 0)+</div>
                <div class="label">kg Waste Recycled</div>
            </div>
            <div class="impact-item">
                <span class="icon">📚</span>
                <div class="value">@(impact?.SchoolsHelped ?? 0)+</div>
                <div class="label">Schools Helped</div>
            </div>
        </div>

        <div style="margin-top: 1.5rem;">
            <a asp-controller="Home" asp-action="Index" class="btn-back">
                🌿 Back to Home
            </a>
            <a asp-controller="Dashboard" asp-action="Index" class="btn-back" style="background: linear-gradient(135deg, #1565C0 0%, #0D47A1 100%); margin-left: 0.5rem;">
                📊 Dashboard
            </a>
        </div>
    </div>
</div>