@model CarbonFootprintTracker.Models.ReportsViewModel
@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-info text-white shadow">
                <div class="card-body">
                    <h1 class="display-4">📊 Weekly & Monthly Reports</h1>
                    <p class="lead">Track your progress and see how you're doing!</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Trend Alert -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="alert alert-@(Model.EmissionChangePercent < 0 ? "success" : Model.EmissionChangePercent > 0 ? "warning" : "info") text-center shadow">
                <h4 class="mb-0">
                    @Model.TrendIcon @Model.TrendMessage
                </h4>
            </div>
        </div>
    </div>

    <!-- Weekly Report -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">📅 Weekly Report</h3>
                    <small>@Model.WeeklyReport.StartDate.ToString("MMM dd, yyyy") - @Model.WeeklyReport.EndDate.ToString("MMM dd, yyyy")</small>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <h5>Total Emissions</h5>
                            <h2 class="text-danger">@Model.WeeklyReport.TotalEmission kg</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Activities</h5>
                            <h2 class="text-primary">@Model.WeeklyReport.TotalActivities</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Daily Average</h5>
                            <h2 class="text-warning">@Model.WeeklyReport.AverageDailyEmission kg</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Highest Category</h5>
                            <h2 class="text-info">@Model.WeeklyReport.HighestCategory</h2>
                            <small>@Model.WeeklyReport.HighestCategoryValue kg</small>
                        </div>
                    </div>

                    <!-- Weekly Daily Breakdown -->
                    <div class="mt-3">
                        <h5>Daily Breakdown</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Day</th>
                                        <th>Date</th>
                                        <th>Emission (kg)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var day in Model.WeeklyReport.DailyEmissions)
                                    {
                                        <tr>
                                            <td><strong>@day.DayName</strong></td>
                                            <td>@day.Date.ToString("MMM dd")</td>
                                            <td>@day.Emission</td>
                                            <td>
                                                @if (day.Emission == 0)
                                                {
                                                    <span class="badge bg-success">✅ No emissions</span>
                                                }
                                                else if (day.Emission < 5)
                                                {
                                                    <span class="badge bg-info">🌱 Low</span>
                                                }
                                                else if (day.Emission < 15)
                                                {
                                                    <span class="badge bg-warning">⚠️ Medium</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">🔥 High</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Report -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">📆 Monthly Report - @Model.MonthlyReport.MonthName @Model.MonthlyReport.Year</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 text-center">
                            <h5>Total Emissions</h5>
                            <h2 class="text-danger">@Model.MonthlyReport.TotalEmission kg</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Activities</h5>
                            <h2 class="text-primary">@Model.MonthlyReport.TotalActivities</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Daily Average</h5>
                            <h2 class="text-warning">@Model.MonthlyReport.AverageDailyEmission kg</h2>
                        </div>
                        <div class="col-md-3 text-center">
                            <h5>Highest Category</h5>
                            <h2 class="text-info">@Model.MonthlyReport.HighestCategory</h2>
                            <small>@Model.MonthlyReport.HighestCategoryValue kg</small>
                        </div>
                    </div>

                    <!-- Monthly Weekly Breakdown -->
                    <div class="mt-3">
                        <h5>Weekly Breakdown</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Week</th>
                                        <th>Period</th>
                                        <th>Emission (kg)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var week in Model.MonthlyReport.WeeklyEmissions)
                                    {
                                        <tr>
                                            <td><strong>Week @week.WeekNumber</strong></td>
                                            <td>@week.StartDate.ToString("MMM dd") - @week.EndDate.ToString("MMM dd")</td>
                                            <td>@week.Emission</td>
                                            <td>
                                                @if (week.Emission == 0)
                                                {
                                                    <span class="badge bg-success">✅ No emissions</span>
                                                }
                                                else if (week.Emission < 10)
                                                {
                                                    <span class="badge bg-info">🌱 Low</span>
                                                }
                                                else if (week.Emission < 30)
                                                {
                                                    <span class="badge bg-warning">⚠️ Medium</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">🔥 High</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="row">
        <div class="col-12 text-center">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg me-2">
                📊 Back to Dashboard
            </a>
            <a asp-controller="CarbonActivities" asp-action="Create" class="btn btn-success btn-lg me-2">
                ➕ Add Activity
            </a>
            <a asp-controller="Rewards" asp-action="Index" class="btn btn-warning btn-lg">
                🏆 My Rewards
            </a>
        </div>
    </div>
</div>