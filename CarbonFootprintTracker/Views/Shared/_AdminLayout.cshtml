<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeafMark Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarbonFootprintTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* 🌿 LeafMark Admin - Earthy Green Theme */
        :root {
            --primary: #2E7D32;
            --primary-light: #4CAF50;
            --primary-dark: #1B5E20;
            --accent: #FFC107;
            --bg-dark: #1a2332;
            --bg-card: #1e2a3a;
        }

        /* Admin Navbar */
        .admin-navbar {
            background: linear-gradient(135deg, #1a2332 0%, #0d1b2a 100%);
            border-bottom: 3px solid var(--primary);
            padding: 0.8rem 0;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        }

            .admin-navbar .navbar-brand {
                font-weight: 700;
                font-size: 1.4rem;
                color: #FFFFFF !important;
                transition: all 0.3s ease;
            }

                .admin-navbar .navbar-brand:hover {
                    color: var(--accent) !important;
                    transform: scale(1.02);
                }

            .admin-navbar .brand-leaf {
                color: var(--accent);
            }

            .admin-navbar .navbar-text {
                color: #A5D6A7 !important;
            }

            /* Admin Nav Links */
            .admin-navbar .nav-link {
                color: #C8E6C9 !important;
                font-weight: 500;
                padding: 0.6rem 1rem;
                border-radius: 8px;
                transition: all 0.3s ease;
                margin: 0 2px;
            }

                .admin-navbar .nav-link:hover {
                    background: rgba(76, 175, 80, 0.2);
                    color: #FFFFFF !important;
                    transform: translateY(-2px);
                }

                .admin-navbar .nav-link.active {
                    background: rgba(76, 175, 80, 0.3);
                    color: var(--accent) !important;
                }

                .admin-navbar .nav-link i {
                    margin-right: 8px;
                }

            /* Dropdown Menu */
            .admin-navbar .dropdown-menu {
                background: #1e2a3a;
                border: 1px solid rgba(76, 175, 80, 0.3);
                border-radius: 12px;
                padding: 0.5rem;
                box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            }

            .admin-navbar .dropdown-item {
                color: #C8E6C9 !important;
                border-radius: 8px;
                padding: 0.6rem 1.2rem;
                transition: all 0.3s ease;
            }

                .admin-navbar .dropdown-item:hover {
                    background: rgba(76, 175, 80, 0.2);
                    color: #FFFFFF !important;
                    transform: translateX(5px);
                }

                .admin-navbar .dropdown-item i {
                    margin-right: 10px;
                    color: var(--accent);
                }

            .admin-navbar .dropdown-divider {
                border-color: rgba(255,255,255,0.1);
            }

            /* Logout Button */
            .admin-navbar .btn-logout {
                background: rgba(244, 67, 54, 0.15);
                color: #EF9A9A !important;
                border: 1px solid rgba(244, 67, 54, 0.3);
                border-radius: 8px;
                padding: 0.5rem 1.2rem;
                transition: all 0.3s ease;
            }

                .admin-navbar .btn-logout:hover {
                    background: rgba(244, 67, 54, 0.3);
                    color: #FFFFFF !important;
                    transform: translateY(-2px);
                    box-shadow: 0 4px 15px rgba(244, 67, 54, 0.3);
                }

            /* More Dropdown Toggle */
            .admin-navbar .dropdown-toggle {
                background: rgba(76, 175, 80, 0.1);
                border-radius: 8px;
                padding: 0.6rem 1.2rem;
                color: #C8E6C9 !important;
                border: none;
                transition: all 0.3s ease;
            }

                .admin-navbar .dropdown-toggle:hover {
                    background: rgba(76, 175, 80, 0.25);
                    color: #FFFFFF !important;
                }

                .admin-navbar .dropdown-toggle::after {
                    color: var(--accent);
                }

        /* Admin Footer */
        .admin-footer {
            background: #0d1b2a;
            color: #A5D6A7;
            border-top: 2px solid var(--primary);
            padding: 1.5rem 0;
            margin-top: 2rem;
        }

            .admin-footer a {
                color: var(--accent);
                text-decoration: none;
            }

                .admin-footer a:hover {
                    color: #FFFFFF;
                    text-decoration: underline;
                }
    </style>

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍃</text></svg>" />
</head>
<body>
    <!-- 🌿 LeafMark Admin Navbar -->
    <nav class="navbar navbar-expand-lg admin-navbar">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-shield-lock-fill" style="color: var(--accent);"></i>
                🍃 LeafMark
                <span style="font-size: 0.8rem; color: var(--accent);">Admin</span>
            </a>

            <!-- Toggler for Mobile -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Content -->
            <div class="collapse navbar-collapse" id="adminNavbar">
                <ul class="navbar-nav me-auto">
                    <!-- Visible Links (Main 3) -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"
                           asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-house-door-fill"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" ? "active" : "")"
                           asp-controller="Admin" asp-action="Users">
                            <i class="bi bi-people-fill"></i> Users
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Activities" ? "active" : "")"
                           asp-controller="Admin" asp-action="Activities">
                            <i class="bi bi-list-ul"></i> Activities
                        </a>
                    </li>

                   
                </ul>

                <!-- Right Side - Admin Info & Logout -->
                <ul class="navbar-nav">
                    <li class="nav-item me-2">
                        <span class="navbar-text">
                            <i class="bi bi-person-circle"></i>
                            <span class="d-none d-md-inline">Admin</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-logout" asp-area="Identity" asp-page="/Account/Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container-fluid mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Admin Footer -->
    <footer class="admin-footer">
        <div class="container text-center">
            <p class="mb-0">
                <i class="bi bi-shield-lock-fill" style="color: var(--accent);"></i>
                &copy; @DateTime.Now.Year - 🍃 LeafMark Admin Panel |
                <em style="color: var(--accent);">"Leave a positive mark on the planet."</em>
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>