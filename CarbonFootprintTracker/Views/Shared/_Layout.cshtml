<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeafMark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarbonFootprintTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* 🌿 LeafMark - Earthy Green Theme */
        :root {
            --primary: #2E7D32;
            --primary-light: #4CAF50;
            --primary-dark: #1B5E20;
            --accent: #FFC107;
            --bg-light: #F0F7F0;
            --text-dark: #2D3748;
            --text-light: #4A5568;
            --white: #FFFFFF;
        }

        /* Navbar Styling */
        .navbar-brand {
            font-weight: 700;
            color: var(--primary) !important;
            font-size: 1.5rem;
        }
        .navbar-brand:hover {
            color: var(--primary-dark) !important;
        }

        .nav-link {
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .nav-link:hover {
            color: var(--primary) !important;
            transform: translateY(-2px);
        }

        .nav-link.active {
            color: var(--primary) !important;
            font-weight: 600;
        }

        /* Footer Styling */
        .footer {
            background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 50%, #1B5E20 100%);
            color: #E8F5E9;
            padding: 3rem 0 1.5rem 0;
            margin-top: 3rem;
            border-top: 4px solid var(--accent);
        }
        .footer h5 {
            color: #FFFFFF;
            font-weight: 600;
            margin-bottom: 1.2rem;
        }
        .footer a {
            color: #A5D6A7;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .footer a:hover {
            color: #FFFFFF;
            text-decoration: underline;
            transform: translateX(5px);
        }
        .footer .social-icons a {
            display: inline-block;
            width: 40px;
            height: 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 50%;
            text-align: center;
            line-height: 40px;
            margin-right: 10px;
            font-size: 18px;
            transition: all 0.3s ease;
        }
        .footer .social-icons a:hover {
            background: var(--accent);
            color: var(--primary-dark);
            transform: translateY(-5px);
        }
        .footer .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 1.5rem;
            margin-top: 1.5rem;
            font-size: 0.9rem;
        }
        .footer .footer-links li {
            list-style: none;
            margin-bottom: 8px;
        }
        .footer .footer-links li a {
            color: #A5D6A7;
        }
        .footer .footer-links li a:hover {
            color: #FFFFFF;
        }
    </style>

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍃</text></svg>" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- 🍃 LeafMark Brand -->
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    🍃 LeafMark
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">🏠 Home</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.HasClaim("IsAdmin", "true") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Dashboard">🔐 Admin Panel</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Reports" asp-action="Index">📈 Reports</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Rewards" asp-action="Index">🏆 Rewards</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CarbonActivities" asp-action="Index">📋 My Activities</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="CarbonActivities" asp-action="Create">➕ Add Activity</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">🔒 Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- 🌿 LeafMark - Beautiful Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <!-- About Section -->
                <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <h5>🍃 LeafMark</h5>
                    <p class="text-light-50" style="color: #A5D6A7;">
                        <em>"Leave a positive mark on the planet."</em>
                    </p>
                    <p style="font-size: 0.95rem; color: #C8E6C9;">
                        Track your carbon footprint, earn rewards,
                        and make sustainable choices for a greener future.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                    <h5>Quick Links</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">🏠 Home</a></li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li><a asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a></li>
                            <li><a asp-controller="Rewards" asp-action="Index">🏆 Rewards</a></li>
                            <li><a asp-controller="CarbonActivities" asp-action="Index">📋 My Activities</a></li>
                        }
                        <li><a asp-controller="Home" asp-action="Privacy">🔒 Privacy Policy</a></li>
                    </ul>
                </div>

                <!-- Contact & Social -->
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5>Contact Us</h5>
                    <ul class="footer-links">
                        <li>
                            <i class="fas fa-envelope" style="color: var(--accent);"></i>
                            <a href="mailto:support@leafmark.com">support@leafmark.com</a>
                        </li>
                        <li>
                            <i class="fas fa-phone" style="color: var(--accent);"></i>
                            <a href="tel:+1234567890">+1 (234) 567-890</a>
                        </li>
                        <li>
                            <i class="fas fa-map-marker-alt" style="color: var(--accent);"></i>
                            <span style="color: #A5D6A7;">Green Planet, Earth 🌍</span>
                        </li>
                    </ul>
                </div>

                <!-- Social Media & Newsletter -->
                <div class="col-lg-3 col-md-6 mb-4 mb-lg-0">
                    <h5>Follow Us</h5>
                    <div class="social-icons">
                        <a href="#" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                    <p style="font-size: 0.85rem; color: #A5D6A7; margin-top: 15px;">
                        <i class="fas fa-leaf" style="color: var(--accent);"></i>
                        Join our green community!
                    </p>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom text-center">
                <div class="row">
                    <div class="col-12">
                        <p class="mb-0">
                            &copy; @DateTime.Now.Year - 🍃 LeafMark |
                            <em>"Leave a positive mark on the planet."</em> |
                            All Rights Reserved
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>