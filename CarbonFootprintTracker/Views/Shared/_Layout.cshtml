<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LeafMark</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarbonFootprintTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        /* 🌿 LeafMark - Earthy Green Theme */
        :root {
            --primary: #2E7D32;
            --primary-light: #4CAF50;
            --primary-dark: #1B5E20;
            --accent: #FFC107;
            --bg-light: #F0F7F0;
            --text-dark: #2D3748;
            --text-light: #4A5568;
            --white: #FFFFFF;
        }

        /* ✅ ULTIMATE FIX: Force everything */
        html, body {
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        body {
            background: #F0F7F0;
            display: flex !important;
            flex-direction: column !important;
            min-height: 100vh !important;
        }

        .main-wrapper {
            display: flex !important;
            flex-direction: column !important;
            min-height: 100vh !important;
            width: 100% !important;
        }

        .content-wrapper {
            flex: 1 0 auto !important;
            padding-bottom: 0 !important;
        }

            .content-wrapper .container {
                padding-bottom: 0.5rem !important;
            }

        /* Navbar Styling */
        .navbar-brand {
            font-weight: 700;
            color: var(--primary) !important;
            font-size: 1.5rem;
        }

            .navbar-brand:hover {
                color: var(--primary-dark) !important;
            }

        .nav-link {
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .nav-link:hover {
                color: var(--primary) !important;
                transform: translateY(-2px);
            }

            .nav-link.active {
                color: var(--primary) !important;
                font-weight: 600;
            }

        /* Chart container */
        .chart-container {
            position: relative;
            height: 200px;
            width: 100%;
        }

        @@media (max-width: 768px) {
            .chart-container {
                height: 150px;
            }
        }

        /* ✅ FIX: Remove margin from footer columns */
        .footer .col-md-3, .footer .col-6 {
            margin-bottom: 0 !important;
            padding: 2px 6px !important;
        }
    </style>

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍃</text></svg>" />
</head>
<body>

    <div class="main-wrapper">
        <!-- Header -->
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        🍃 LeafMark
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">🏠 Home</a>
                            </li>
                            @if (User.Identity.IsAuthenticated)
                            {
                                @if (User.HasClaim("IsAdmin", "true") || User.IsInRole("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Dashboard">🔐 Admin Panel</a>
                                    </li>
                                }
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Reports" asp-action="Index">📈 Reports</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Rewards" asp-action="Index">🏆 Rewards</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="CarbonActivities" asp-action="Index">📋 My Activities</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="CarbonActivities" asp-action="Create">➕ Add Activity</a>
                                </li>
                            }
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">🔒 Privacy</a>
                            </li>
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Content -->
        <div class="content-wrapper">
            <div class="container">
                <main role="main" class="pb-2">
                    @RenderBody()
                </main>
            </div>
        </div>

        <!-- 🌿 LeafMark - SUPER COMPACT FOOTER (100% FIXED) -->
        <footer class="footer">
            <div class="container" style="padding: 0 10px !important;">
                <div class="row" style="margin: 0 !important;">
                    <!-- Brand -->
                    <div class="col-md-3 col-6" style="padding: 2px 6px !important;">
                        <div style="font-weight: 700; font-size: 0.8rem; color: #FFFFFF;">🍃 LeafMark</div>
                        <div style="font-style: italic; font-size: 0.55rem; color: #A5D6A7;">"Leave a positive mark on the planet."</div>
                    </div>

                    <!-- Contact -->
                    <div class="col-md-3 col-6" style="padding: 2px 6px !important;">
                        <div style="color: #FFFFFF; font-weight: 600; font-size: 0.65rem; margin-bottom: 1px;">Contact</div>
                        <div style="font-size: 0.6rem; color: #A5D6A7; line-height: 1.3;">
                            <div><i class="fas fa-envelope" style="color: #FFC107; width: 14px; font-size: 9px;"></i> <a href="mailto:support@leafmark.com" style="color: #A5D6A7; text-decoration: none;">support@leafmark.com</a></div>
                            <div><i class="fas fa-phone" style="color: #FFC107; width: 14px; font-size: 9px;"></i> <a href="tel:+1234567890" style="color: #A5D6A7; text-decoration: none;">+1 (234) 567-890</a></div>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="col-md-3 col-6" style="padding: 2px 6px !important;">
                        <div style="color: #FFFFFF; font-weight: 600; font-size: 0.65rem; margin-bottom: 1px;">Links</div>
                        <div style="font-size: 0.6rem; color: #A5D6A7; line-height: 1.3;">
                            <div><a asp-controller="Home" asp-action="Index" style="color: #A5D6A7; text-decoration: none;">🏠 Home</a></div>
                            @if (User.Identity.IsAuthenticated)
                            {
                                <div><a asp-controller="Dashboard" asp-action="Index" style="color: #A5D6A7; text-decoration: none;">📊 Dashboard</a></div>
                            }
                            <div><a asp-controller="Home" asp-action="Privacy" style="color: #A5D6A7; text-decoration: none;">🔒 Privacy</a></div>
                        </div>
                    </div>

                    <!-- Social -->
                    <div class="col-md-3 col-6" style="padding: 2px 6px !important;">
                        <div style="color: #FFFFFF; font-weight: 600; font-size: 0.65rem; margin-bottom: 1px;">Follow</div>
                        <div style="display: flex; gap: 2px; flex-wrap: wrap;">
                            <a href="#" style="display: inline-block; width: 20px; height: 20px; background: rgba(255,255,255,0.1); border-radius: 50%; text-align: center; line-height: 20px; font-size: 9px; color: #A5D6A7; transition: all 0.3s ease;"><i class="fab fa-facebook-f"></i></a>
                            <a href="#" style="display: inline-block; width: 20px; height: 20px; background: rgba(255,255,255,0.1); border-radius: 50%; text-align: center; line-height: 20px; font-size: 9px; color: #A5D6A7; transition: all 0.3s ease;"><i class="fab fa-twitter"></i></a>
                            <a href="#" style="display: inline-block; width: 20px; height: 20px; background: rgba(255,255,255,0.1); border-radius: 50%; text-align: center; line-height: 20px; font-size: 9px; color: #A5D6A7; transition: all 0.3s ease;"><i class="fab fa-instagram"></i></a>
                            <a href="#" style="display: inline-block; width: 20px; height: 20px; background: rgba(255,255,255,0.1); border-radius: 50%; text-align: center; line-height: 20px; font-size: 9px; color: #A5D6A7; transition: all 0.3s ease;"><i class="fab fa-linkedin-in"></i></a>
                        </div>
                        <div style="font-size: 0.5rem; color: #A5D6A7; margin-top: 1px;"><i class="fas fa-leaf" style="color: #FFC107;"></i> Join us!</div>
                    </div>
                </div>

                <!-- Footer Bottom -->
                <div style="border-top: 1px solid rgba(255,255,255,0.08); padding-top: 3px; margin-top: 3px; font-size: 0.45rem; text-align: center; color: #A5D6A7;">
                    &copy; @DateTime.Now.Year - 🍃 LeafMark | All Rights Reserved
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>